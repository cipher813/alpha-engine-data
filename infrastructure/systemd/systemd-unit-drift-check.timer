[Unit]
Description=Daily installed-vs-repo systemd unit drift check — once a day (config#2352)
# NO Requires=systemd-unit-drift-check.service here, deliberately
# (alpha-engine-config-I9000). `Requires=` in a TIMER's [Unit] is a START
# dependency OF THE TIMER, so `systemctl enable --now
# systemd-unit-drift-check.timer` — which BOTH install-daily-news.sh and
# install-metron-intraday.sh run, on two different boxes — also enqueued a start
# job for the service. The binding is the `Unit=` line below.
#
# And no install-time run is wanted here even though the check is read-only: the
# installer has just copied these unit files, so a drift comparison taken in the
# same second answers a question nobody asked, while emitting a CloudWatch
# datapoint dated to the deploy rather than to the daily cadence this check's
# freshness is judged on.

[Timer]
Unit=systemd-unit-drift-check.service
# Once daily is enough to satisfy the issue's "pages within a day"
# acceptance bar for a deliberate on-box unit edit, without adding
# meaningful load. Offset from the top of the hour to avoid piling onto
# other :00 timers on the same box.
OnCalendar=*-*-* 06:17:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
