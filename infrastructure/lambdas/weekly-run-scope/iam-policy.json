{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:711398986525:log-group:/aws/lambda/alpha-engine-weekly-run-scope:*"
    },
    {
      "Sid": "ReadOwnDefinitionAndHistory",
      "Effect": "Allow",
      "Action": [
        "states:DescribeStateMachine",
        "states:GetExecutionHistory"
      ],
      "Resource": [
        "arn:aws:states:us-east-1:711398986525:stateMachine:ne-weekly-freshness-pipeline",
        "arn:aws:states:us-east-1:711398986525:execution:ne-weekly-freshness-pipeline:*"
      ]
    },
    {
      "Sid": "ReadAndWriteRunScopeArtifact",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::alpha-engine-research/backtest/*/run_scope.json"
    },
    {
      "Sid": "ListRunScopePrefixForAbsentKeyDetection",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::alpha-engine-research",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backtest/*"
          ]
        }
      }
    }
  ]
}
