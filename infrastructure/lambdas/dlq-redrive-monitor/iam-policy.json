{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:711398986525:log-group:/aws/lambda/alpha-engine-dlq-redrive-monitor:*"
    },
    {
      "Sid": "SqsQueueUrlAndAttributes",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:711398986525:nousergon-overseer-intake",
        "arn:aws:sqs:us-east-1:711398986525:nousergon-overseer-intake-dlq"
      ]
    },
    {
      "Sid": "SqsRedriveMoveTask",
      "Effect": "Allow",
      "Action": [
        "sqs:StartMessageMoveTask",
        "sqs:ListMessageMoveTasks"
      ],
      "Resource": "arn:aws:sqs:us-east-1:711398986525:nousergon-overseer-intake-dlq"
    },
    {
      "Sid": "SnsPublishAlerts",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:711398986525:alpha-engine-alerts"
    },
    {
      "Sid": "S3DedupMarkerReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::alpha-engine-research/_alerts/_dedup/*"
    },
    {
      "Sid": "S3DedupMarkerListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::alpha-engine-research",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "_alerts/_dedup/*"
          ]
        }
      }
    },
    {
      "Sid": "TelegramAndMuteListSSM",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:711398986525:parameter/alpha-engine/TELEGRAM_BOT_TOKEN",
        "arn:aws:ssm:us-east-1:711398986525:parameter/alpha-engine/TELEGRAM_CHAT_ID",
        "arn:aws:ssm:us-east-1:711398986525:parameter/alpha-engine/alerts/source_mutes"
      ]
    }
  ]
}
